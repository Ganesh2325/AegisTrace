# Required production configuration. Values are supplied by the task role and Secrets Manager.
# This file contains names only. Do not put real secrets here.

AEGIS_ENVIRONMENT=prod
AEGIS_SEED_ENABLED=false
AEGIS_FAILURE_SIMULATION=false
AEGIS_COOKIE_SECURE=true
AEGIS_JWT_SECRET=
AEGIS_INTERNAL_TOKEN=
FRONTEND_ORIGIN=https://app.example.com
AEGIS_RUNTIME_URL=http://runtime.aegistrace.local:8090
DATABASE_URL=jdbc:postgresql://database.internal:5432/aegistrace
POSTGRES_USER=aegis_migrate
POSTGRES_PASSWORD=
REDIS_ENABLED=true
REDIS_HOST=redis.internal
REDIS_PASSWORD=
S3_BUCKET=aegistrace-documents
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
AEGIS_RELEASE_SHA=
AEGIS_IMAGE_DIGEST=
SEED_KNOWLEDGE=false
