# This stack is the production contract. It has not been applied.
# Apply only with an encrypted remote backend, a real account, and reviewed variables.
# Do not commit terraform state or variable files that contain secrets.

terraform {
  required_version = ">= 1.6.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.70"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "aws" {
  region = var.region
}
