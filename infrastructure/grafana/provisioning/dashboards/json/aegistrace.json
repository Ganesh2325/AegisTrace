{
  "title": "AegisTrace",
  "uid": "aegistrace",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Runs started",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(aegis_runs_total[5m]))", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Policy decisions",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "sum by (decision) (rate(aegis_policy_decisions_total[5m]))", "refId": "A"}]
    }
  ]
}
