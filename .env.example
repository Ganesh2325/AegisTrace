# Copy to .env for local Docker Compose. These are development defaults.
# Production must replace every value that contains "change-me".
# Never commit a real .env file.

POSTGRES_DB=aegistrace
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-postgres-dev-only

REDIS_PASSWORD=change-me-redis-dev-only

# Local object storage is Garage. MinIO's public images were removed from Docker Hub.
# These are development credentials. Garage requires GK + 24 hex chars and a 64-hex secret.
S3_BUCKET=aegistrace-documents
S3_ENDPOINT=http://garage:3900
S3_REGION=us-east-1
S3_ACCESS_KEY=GK000000000000000000000001
S3_SECRET_KEY=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
GARAGE_ADMIN_TOKEN=change-me-garage-admin-dev

AEGIS_JWT_SECRET=change-me-jwt-secret-at-least-32-bytes
AEGIS_INTERNAL_TOKEN=change-me-internal-token
AEGIS_SEED_ENABLED=true
AEGIS_SEED_PASSWORD=change-me-dev-password
AEGIS_CONTENT_LOGGING=false

# Leave blank to use the offline grounded-extractive provider.
# Set both to call a real OpenAI-compatible chat/embeddings API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

AEGIS_ENVIRONMENT=dev
FRONTEND_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://control-plane:8080
NEXT_PUBLIC_API_BASE=/backend
NEXT_PUBLIC_JAEGER_URL=http://localhost:16686
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
